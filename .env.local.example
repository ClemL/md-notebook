# Send/Receive (the notebook's only server-backed feature) talks to an Upstash Redis
# database over its REST API. Copy this file to .env.local and fill both values in.
#
# .env.local is gitignored; these are server-side secrets and must never be prefixed
# with NEXT_PUBLIC_, or the token would ship inside the browser bundle.
#
# Both values come from the Upstash console: your database -> REST API.
# Without them the app still runs — Send and Receive answer
# "Transfer is not set up on this deployment" and nothing else changes.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
